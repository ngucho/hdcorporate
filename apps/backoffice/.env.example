DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Production: https://insite.hdcorporate.com local default: http://localhost:3001
# If 3001 is already in use: set BACKOFFICE_DEV_PORT=3011 (or any free port) and match APP_BASE_URL, e.g. http://localhost:3011
APP_BASE_URL=http://localhost:3001
# BACKOFFICE_DEV_PORT=3011

# Comma-separated allowlist; if empty, any Auth0 user can access (dev only)
BACKOFFICE_ALLOWED_EMAILS=you@company.com
