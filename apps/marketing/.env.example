# Public API origin (no trailing slash). Production: https://api.hdcorporate.com
# Local with apps/api on port 3002: http://localhost:3002 (must match API_DEV_PORT if you override it)
NEXT_PUBLIC_API_URL=https://api.hdcorporate.com

# If port 3000 is busy: MARKETING_DEV_PORT=3010
# MARKETING_DEV_PORT=3010

# Dev bundler: par défaut le script utilise --webpack (évite panics Turbopack + PostCSS sur Windows).
# Pour forcer Turbopack : MARKETING_TURBOPACK=1 (shell ou .env.local)
# MARKETING_TURBOPACK=1

# --- Calendrier (embed Cal.com uniquement) ---
# Partie d’URL après https://cal.com/ ex. monuser/consultation-30min
NEXT_PUBLIC_CALCOM_CAL_LINK=monuser/consultation-30min
# Checklist : docs/setup/calcom.md

# Supabase Postgres required for SSR (e.g. services list on the home page).
# Pooler / transaction mode (port 6543) recommended for serverless.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional: only if you run drizzle-kit from this app (normally use root + packages/db).
# DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Redis / Upstash: not used by apps/marketing (rate limit + cache live on apps/api only).
