DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# En production Vercel (VERCEL_ENV=production) ou Node prod hors Vercel, les deux variables
# ci-dessus sont obligatoires : sans Redis, POST /api/contact et /api/leads répondent 503.

# CORS: origines navigateur autorisées (CSV). Pour tester depuis une preview Vercel du site marketing,
# ajoutez l’URL exacte (ex. https://mon-app-marketing.vercel.app) dans la liste ci-dessous ou dans EXTRA.
API_ALLOWED_ORIGINS=https://www.hdcorporate.com,https://hdcorporate.com,http://localhost:3000
# Origines supplémentaires (même format CSV), fusionnées avec API_ALLOWED_ORIGINS (dédoublonnage).
# API_ALLOWED_ORIGINS_EXTRA=https://votre-preview-marketing.vercel.app

# If port 3002 is busy: API_DEV_PORT=3003 then set marketing NEXT_PUBLIC_API_URL=http://localhost:3003 and add that origin to API_ALLOWED_ORIGINS if needed.
# API_DEV_PORT=3003

# --- Resend (emails transactionnels : confirmations Cal.com, etc.) ---
# https://resend.com
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=HD Corporate <bookings@votredomaine.com>

# --- Cal.com (webhooks → base `bookings` + emails via Resend) ---
# Secret du webhook (Settings → Developer → Webhooks) HMAC header x-cal-signature-256
# CALCOM_WEBHOOK_SECRET=
# Fuseau pour dériver booking_date / slot_time depuis startTime (défaut Europe/Paris)
# CALCOM_BOOKING_TIMEZONE=Europe/Paris

# --- Logging (JSON en prod ; pretty en local si LOG_PRETTY=1) ---
# LOG_LEVEL=debug
# LOG_PRETTY=0

# --- Auth0 (JWT access token + RBAC pour /internal/v1/*) ---
# Tenant sans https (ex. dev-xxx.eu.auth0.com)
# AUTH0_DOMAIN=
# Identifiant de l’API Auth0 (APIs → votre API → Identifier)
# AUTH0_AUDIENCE=https://api.hdcorporate.com
# Si custom domain ou issuer atypique :
# AUTH0_ISSUER=https://login.votredomaine.com/
# Namespace des claims custom (ex. Action post-login → rôles) :
# AUTH0_CLAIM_NAMESPACE=https://hd-corporate.com
# AUTH0_CLOCK_TOLERANCE_SECONDS=30
